    "morgan": "^1.10.1",
    "nodemailer": "^8.0.1",
    "puppeteer": "^24.37.5",
    "ua-parser-js": "^2.0.9",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^9.9.0",
