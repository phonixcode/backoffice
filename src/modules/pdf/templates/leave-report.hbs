<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: Arial, sans-serif;
      font-size: 12px;
      color: #1a1a1a;
      padding: 40px;
      background: #fff;
    }

    /* ── Header ── */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 20px;
      border-bottom: 3px solid #1d4ed8;
      margin-bottom: 28px;
    }
    .company-name { font-size: 22px; font-weight: 700; color: #1d4ed8; }
    .company-sub  { font-size: 11px; color: #6b7280; margin-top: 4px; }
    .report-meta  { text-align: right; }
    .report-meta h2 { font-size: 16px; font-weight: 600; }
    .report-meta p  { font-size: 11px; color: #6b7280; margin-top: 4px; }

    /* ── Summary Cards ── */
    .summary-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 28px;
    }
    .card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 14px;
      text-align: center;
    }
    .card-label { font-size: 11px; color: #6b7280; margin-bottom: 6px; }
    .card-value { font-size: 20px; font-weight: 700; color: #1d4ed8; }

    /* ── Status breakdown ── */
    .breakdown {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 28px;
    }
    .breakdown-item {
      border-radius: 6px;
      padding: 10px 14px;
      text-align: center;
    }
    .breakdown-item.approved  { background: #dcfce7; border: 1px solid #86efac; }
    .breakdown-item.pending   { background: #fef9c3; border: 1px solid #fde047; }
    .breakdown-item.rejected  { background: #fee2e2; border: 1px solid #fca5a5; }
    .breakdown-item.cancelled { background: #f3f4f6; border: 1px solid #d1d5db; }
    .breakdown-label { font-size: 10px; color: #6b7280; margin-bottom: 4px; }
    .breakdown-value { font-size: 16px; font-weight: 700; }
    .breakdown-item.approved  .breakdown-value { color: #16a34a; }
    .breakdown-item.pending   .breakdown-value { color: #ca8a04; }
    .breakdown-item.rejected  .breakdown-value { color: #dc2626; }
    .breakdown-item.cancelled .breakdown-value { color: #6b7280; }

    /* ── Table ── */
    table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
    th {
      background: #1d4ed8;
      color: #fff;
      padding: 9px 10px;
      text-align: left;
      font-size: 11px;
      font-weight: 600;
    }
    td {
      padding: 8px 10px;
      border-bottom: 1px solid #e2e8f0;
      font-size: 11px;
    }
    tr:nth-child(even) td { background: #f8fafc; }

    /* status badges inline */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 99px;
      font-size: 10px;
      font-weight: 600;
    }
    .badge.approved  { background: #dcfce7; color: #16a34a; }
    .badge.pending   { background: #fef9c3; color: #ca8a04; }
    .badge.rejected  { background: #fee2e2; color: #dc2626; }
    .badge.cancelled { background: #f3f4f6; color: #6b7280; }

    /* ── Footer ── */
    .footer {
      border-top: 1px solid #e2e8f0;
      padding-top: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .footer p { font-size: 10px; color: #9ca3af; }
    .confidential { color: #ef4444; font-weight: 600; }
  </style>
</head>
<body>

  <!-- Header -->
  <div class="header">
    <div>
      <div class="company-name">BackOffice NG</div>
      <div class="company-sub">support@backoffice.ng · Lagos, Nigeria</div>
    </div>
    <div class="report-meta">
      <h2>Leave Report</h2>
      <p>Generated: {{generatedAt}}</p>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="summary-cards">
    <div class="card">
      <div class="card-label">Total Requests</div>
      <div class="card-value">{{totalRequests}}</div>
    </div>
    <div class="card">
      <div class="card-label">Total Days Taken</div>
      <div class="card-value">{{totalDays}}</div>
    </div>
    <div class="card">
      <div class="card-label">Avg Days Per Request</div>
      <div class="card-value">{{avgDays}}</div>
    </div>
  </div>

  <!-- Status Breakdown -->
  <div class="breakdown">
    <div class="breakdown-item approved">
      <div class="breakdown-label">Approved</div>
      <div class="breakdown-value">{{statusCounts.approved}}</div>
    </div>
    <div class="breakdown-item pending">
      <div class="breakdown-label">Pending</div>
      <div class="breakdown-value">{{statusCounts.pending}}</div>
    </div>
    <div class="breakdown-item rejected">
      <div class="breakdown-label">Rejected</div>
      <div class="breakdown-value">{{statusCounts.rejected}}</div>
    </div>
    <div class="breakdown-item cancelled">
      <div class="breakdown-label">Cancelled</div>
      <div class="breakdown-value">{{statusCounts.cancelled}}</div>
    </div>
  </div>

  <!-- Leave Table -->
  <table>
    <thead>
      <tr>
        <th>Employee ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>Type</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th>Days</th>
        <th>Status</th>
        <th>Reason</th>
      </tr>
    </thead>
    <tbody>
      {{#each records}}
      <tr>
        <td>{{this.employeeId}}</td>
        <td>{{this.fullName}}</td>
        <td>{{this.department}}</td>
        <td>{{this.type}}</td>
        <td>{{this.startDate}}</td>
        <td>{{this.endDate}}</td>
        <td>{{this.days}}</td>
        <td>
          <span class="badge {{this.statusClass}}">
            {{this.status}}
          </span>
        </td>
        <td>{{this.reason}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Footer -->
  <div class="footer">
    <p>BackOffice NG · support@backoffice.ng · Lagos, Nigeria</p>
    <p class="confidential">CONFIDENTIAL — For internal use only</p>
  </div>

</body>
</html>