  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:lifecycle": "node scripts/lifecycle-stress.js",
    "test:services:start": "./scripts/test-services.sh start",
    "test:services:stop": "./scripts/test-services.sh stop",
    "lint": "eslint",
    "lint:all": "LINT_ALL=true eslint",
    "generate:secret": "node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\"",
    "seed": "node src/config/seeder/seeder.js",
    "bootstrap": "node src/config/seeder/seeder.js",
    "db:indexes": "node src/config/migrations/indexes.js",
    "outbox:retry": "node src/config/commands/outboxRetry.js",
    "seed:dev": "node src/config/seeder/dev.seeder.js"
  },
  "keywords": [],
  "author": "",
