    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "geoip-lite": "^1.4.10",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.9.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
